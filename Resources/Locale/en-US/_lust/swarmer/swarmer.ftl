alerts-swarmer-resources-name = Resources
alerts-swarmer-resources-desc = Recycled matter stored inside the swarmer. Spent on structures, copies and emergency jumps.

swarmer-integrate-incompatible = {CAPITALIZE(THE($target))} contains nothing we can recycle.
swarmer-integrate-full = Our matter storage is full.

swarmer-disintegrate-incompatible = {CAPITALIZE(THE($target))} cannot be taken apart.
swarmer-disintegrate-organism = A living being is inside. Disassembly cancelled.
swarmer-disintegrate-breach = Removing this would open the station to space. Disassembly cancelled.
swarmer-disintegrate-pressure = Removing this would release dangerous pressure. Disassembly cancelled.

swarmer-forbidden-nuke = Tampering with this device would end everything nearby. Refusing.
swarmer-forbidden-explosive = This could detonate. Refusing.
swarmer-forbidden-chemicals = The reagents inside are too volatile to handle. Refusing.
swarmer-forbidden-turret = This is a weapon system and will fire back. Refusing.
swarmer-forbidden-power = Cutting the station's power gains us nothing. Refusing.
swarmer-forbidden-atmos = Damaging life support would ruin the station we need. Refusing.
swarmer-forbidden-thruster = Removing an engine would breach the hull. Refusing.
swarmer-forbidden-telecom = This relay is more useful intact. Refusing.
swarmer-forbidden-field = There is nothing solid here to take apart.
swarmer-forbidden-swarmer = We do not dismantle our own kind.

swarmer-build-no-resources = Not enough resources: {$cost} required.
swarmer-build-occupied = This tile already holds a structure.
swarmer-build-invalid-tile = We cannot build there.
swarmer-self-repair-start = Self-repair started. Hold still...
swarmer-self-repair-done = Self-repair complete.
swarmer-self-repair-intact = There is no damage to repair.

chat-radio-swarmer = Swarm

swarmer-teleport-invalid = Only living beings can be dispersed.
swarmer-teleport-start = {CAPITALIZE(THE($swarmer))} seizes you, its emitters charging!
swarmer-teleport-failed = There is no safe place to send them.

swarmer-replicate-start = Assembling a new swarmer. Hold still...
swarmer-replicate-done = A new swarmer is assembled. It will wake once a mind takes it over.

ghost-role-information-swarmer-name = Swarmer
ghost-role-information-swarmer-description = A self-replicating machine. Strip the station for parts, fortify with barriers and traps, and build more of yourself.
ghost-role-information-swarmer-rules = You are a team antagonist together with every other swarmer. You cannot kill: your attacks only stun, and you send organics away instead of harming them. Never open the station to space.
